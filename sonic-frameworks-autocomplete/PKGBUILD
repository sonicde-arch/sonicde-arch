pkgname=sonic-frameworks-autocomplete
pkgver=6.31.0.1
pkgrel=1
pkgdesc='Text completion helpers and widgets'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-autocomplete'
license=(
	'LGPL-2.0-only'
	'LGPL-3.0-only'
)
depends=(
	'glibc'
	'libstdc++'
	'qt6-base'
	'sonic-frameworks-settings'
	'sonic-frameworks-text-codec'
	'sonic-frameworks-widgets-addons'
)
makedepends=(
	'doxygen'
	'qt6-tools'
	'sonic-frameworks-cmake-modules'
)
provides=('kcompletion')
conflicts=('kcompletion')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('50888a865ec5844fc49248ed3ca60e9ed51d43f04b790f8707fe726af6243c54')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
