pkgname=sonic-silver
pkgver=6.8.2
pkgrel=1
pkgdesc='Artwork, styles and assets for the Silver visual style for SonicDE'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-silver'
license=('LGPL-2.0-or-later')
depends=(
	'glibc'
	'libstdc++'
	'qt6-base'
	'qt6-declarative'
	'qt6-svg'
	'sonic-decoration'
	'sonic-frameworks-color-scheme'
	'sonic-frameworks-core-addons'
	'sonic-frameworks-gui-addons'
	'sonic-frameworks-icon-themes'
	'sonic-frameworks-internationalization'
	'sonic-frameworks-logging'
	'sonic-frameworks-qt-integration'
	'sonic-frameworks-quick-ui'
	'sonic-frameworks-settings'
	'sonic-frameworks-settings-utils'
	'sonic-frameworks-widgets-addons'
	'sonic-frameworks-windowsystem'
	'sonic-silver-icons'
)
makedepends=('sonic-frameworks-cmake-modules')
provides=(
	'breeze'
	'sonic-silver-theme'
)
conflicts=(
	'breeze'
	'sonic-silver-theme'
)
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('70e0575ab8d0336befa5ba4b427e3b78c7b262f1e6b203121dfb8b6f1d02d4e3')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
