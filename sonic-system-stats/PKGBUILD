# Maintainer: callmetango
# Contributor: Antonio Rojas <arojas@archlinux.org>

pkgname=sonic-system-stats
pkgver=6.7.5
pkgrel=1
pkgdesc='A plugin based system monitoring daemon'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-system-stats'
license=('LGPL-2.0-or-later')
depends=(
	'glibc'
	'libstdc++'
	'lm_sensors'
	'qt6-base'
	'sonic-frameworks-core-addons'
	'sonic-frameworks-crash-handler'
	'sonic-frameworks-device-integration'
	'sonic-frameworks-internationalization'
	'sonic-frameworks-io'
	'sonic-system-monitor-library'
)
makedepends=(
	'libnl'
	'sonic-frameworks-cmake-modules'
	'sonic-frameworks-networkmanager'
)
optdepends=(
	'libnl: network usage monitor'
	'systemd-libs: GPU monitor'
	'sonic-frameworks-networkmanager: network usage monitor'
)
provides=('ksystemstats')
conflicts=('ksystemstats')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('10938690f3b514b720e4b5c58d75decef6352ce5d9f1c6d06f4be5dff1e6b62f')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
