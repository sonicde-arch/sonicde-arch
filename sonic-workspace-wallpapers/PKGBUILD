pkgname=sonic-workspace-wallpapers
pkgver=6.8.2
pkgrel=1
pkgdesc='Additional wallpapers for the Sonic Workspace'
arch=('any')
url='https://github.com/Sonic-DE/sonic-workspace-wallpapers'
license=('LGPL')
makedepends=(
	'qt6-base'
	'sonic-frameworks-cmake-modules'
)
options=('!debug')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('0b7a026d4c7bdff302bf48fc4f27ee530231f0a81302e006ab3ed3b6962b902c')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
