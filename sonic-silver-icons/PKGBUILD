pkgname=sonic-silver-icons
pkgver=6.31.0
pkgrel=1
pkgdesc='Silver icon theme'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-silver-icons'
license=(
	'LGPL-3.0-or-later'
	'LGPL-2.1-only'
)
depends=(
	'glibc'
	'qt6-base'
)
makedepends=(
	'python-lxml'
	'sonic-frameworks-cmake-modules'
)
provides=('breeze-icons')
conflicts=('breeze-icons')
replaces=('sonic-frameworks-silver-icons')
options=('!debug')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('c6a04f28d0e08a7bf2ffd0d8421c0b63e36c491cb84cf767e12c7cdd301bba15')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBINARY_ICONS_RESOURCE=ON \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
