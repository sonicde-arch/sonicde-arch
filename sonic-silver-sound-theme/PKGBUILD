# Maintainer: callmetango
# Contributor: Antonio Rojas <arojas@archlinux.org>

pkgname=sonic-silver-sound-theme
pkgdesc='Ocean Sound Theme for SonicDE'
pkgver=6.8.2
pkgrel=1
arch=('any')
url='https://github.com/Sonic-DE/sonic-silver-sound-theme'
license=('LGPL-2.0-or-later')
depends=()
makedepends=(
	'qt6-base'
	'sonic-frameworks-cmake-modules'
)
provides=('ocean-sound-theme')
conflicts=('ocean-sound-theme')
options=('!debug')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('b1288d35512fc94a553e7e0e5b585aebca5f92dee15d55299c41e2283923e0e2')

build() {
	cmake -B build -S $pkgname-$pkgver
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
