# Maintainer: callmetango
# Contributor: Antonio Rojas <arojas@archlinux.org>

pkgname=sonic-rdp-server
pkgver=6.7.5
pkgrel=1
pkgdesc='Library and examples for creating an RDP server'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-rdp-server'
license=('LGPL-2.0-or-later')
depends=(
	'freerdp'
	'glibc'
	'libstdc++'
	'libxkbcommon'
	'pam'
	'qt6-base'
	'qtkeychain-qt6'
	'sonic-frameworks-core-addons'
	'sonic-frameworks-crash-handler'
	'sonic-frameworks-gui-addons'
	'sonic-frameworks-internationalization'
	'sonic-frameworks-quick-ui-addons'
	'sonic-frameworks-settings'
	'sonic-frameworks-settings-utils'
	'sonic-frameworks-status-notification'
	'sonic-pipewire'
	'systemd-libs'
)
makedepends=('sonic-frameworks-cmake-modules')
provides=('krdp')
conflicts=('krdp')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('81da23eedb37f601230a59fdace07248107e24fca465cf979e95a196d267b4d7')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
