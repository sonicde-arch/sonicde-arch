pkgname=sonic-frameworks-unit-conversion
pkgver=6.31.0
pkgrel=1
pkgdesc='Support for unit conversion'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-unit-conversion'
license=(
	'LGPL-2.0-only'
	'LGPL-3.0-only'
)
depends=(
	'glibc'
	'libstdc++'
	'qt6-base'
	'sonic-frameworks-internationalization'
)
makedepends=(
	'doxygen'
	'python-build'
	'python-setuptools'
	'qt6-tools'
	'sonic-frameworks-cmake-modules'
	'sonic-pyside6'
	'sonic-shiboken6-generator'
)
optdepends=('sonic-pyside6: Python bindings')
provides=('kunitconversion')
conflicts=('kunitconversion')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('3b19e7fbe8d7f10946fff058dfe289e037fd0bedf362c349510389b9663a8a0d')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
