pkgname=sonic-oxygen-sounds
pkgdesc='The Oxygen Sound Theme'
pkgver=6.8.0
pkgrel=1
arch=('any')
url='https://github.com/Sonic-DE/sonic-oxygen-sounds'
license=('LGPL-2.0-or-later')
depends=()
makedepends=('sonic-frameworks-cmake-modules')
provides=('oxygen-sounds')
conflicts=('oxygen-sounds')
options=('!debug')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('ccfe0e8647b5a21eccdb41f0126dc63d1b3000a4087168fe2450e798ec165b9f')

build() {
	cmake -B build -S "$pkgname-$pkgver"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
