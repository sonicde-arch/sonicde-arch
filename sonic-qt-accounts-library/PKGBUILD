pkgname=sonic-qt-accounts-library
pkgdesc='Qt-based client library for accessing the online accounts database'
pkgver=1.17
pkgrel=1
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-qt-accounts-library'
license=('LGPL-2.1-only')
depends=(
	'glib2'
	'glibc'
	'libaccounts-glib'
	'libgcc'
	'libstdc++'
	'qt6-base'
)
makedepends=('cmake')
provides=('libaccounts-qt')
conflicts=('libaccounts-qt')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('cf622eee8f29e1190e7e781d5cb3a67ea56a324eb755e7ee76b5d71855f71e36')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
